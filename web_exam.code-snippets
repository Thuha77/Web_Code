  "Tourism": {
    "prefix": "tour",
    "body": [
      "/*",
      "Run this SQL ONCE in phpMyAdmin's SQL tab.",
      "Do not paste it into PHP as executable PHP code.",
      "",
      "CREATE DATABASE tourism;",
      "USE tourism;",
      "",
      "CREATE TABLE tourist_spot (",
      "    SpotID INT PRIMARY KEY,",
      "    SpotName VARCHAR(100),",
      "    Region VARCHAR(20),",
      "    Category VARCHAR(30),",
      "    Rating FLOAT,",
      "    EntryFee DECIMAL(10,2),",
      "    VisitorsPerYear INT",
      ");",
      "",
      "INSERT INTO tourist_spot VALUES",
      "(1, 'Cox''s Bazar Beach', 'CTG', 'Beach', 4.9, 0, 150000),",
      "(2, 'Sundarbans Forest', 'KHL', 'Nature', 4.3, 150, 80000),",
      "(3, 'Ratargul Forest', 'SYL', 'Nature', 4.8, 100, 60000),",
      "(4, 'Kuakata Beach', 'PTU', 'Beach', 4.5, 0, 90000),",
      "(5, 'Shat Gambuj Mosque', 'BGH', 'Heritage', 4.7, 30, 70000),",
      "(6, 'Paharpur', 'NWG', 'Heritage', 4.1, 30, 40000);",
      "*/",
      "",
      "<!DOCTYPE html>",
      "<html>",
      "<head>",
      "    <title>Tourism Database</title>",
      "</head>",
      "<body>",
      "<h2>Tourism Database Results</h2>",
      "<?php",
      "$conn = mysqli_connect(\"localhost\", \"root\", \"\", \"tourism\");",
      "if (!$conn) {",
      "    die(\"Connection failed: \" . mysqli_connect_error());",
      "}",
      "",
      "function showData($conn, $sql) {",
      "    $result = mysqli_query($conn, $sql);",
      "    if (!$result) die(mysqli_error($conn));",
      "    while ($row = mysqli_fetch_assoc($result)) {",
      "        foreach ($row as $key => $value) {",
      "            echo $key . \": \" . $value . \" | \";",
      "        }",
      "        echo \"<br>\";",
      "    }",
      "}",
      "",
      "// Question 1",
      "echo \"<h3>1. Filter Tourist Spots</h3>\";",
      "$sql1 = \"SELECT SpotName, Region, Rating",
      "         FROM tourist_spot",
      "         WHERE Rating > 4.5 OR SpotName LIKE '%Beach%'",
      "         ORDER BY Rating DESC\";",
      "showData($conn, $sql1);",
      "",
      "// Question 2",
      "echo \"<h3>2. Update Tourist Spots</h3>\";",
      "$sql2 = \"UPDATE tourist_spot",
      "         SET Rating = Rating + 0.2, EntryFee = EntryFee * 1.10",
      "         WHERE Rating BETWEEN 4.0 AND 4.5 AND EntryFee > 0\";",
      "if (mysqli_query($conn, $sql2)) {",
      "    echo \"Update successful!<br>\";",
      "} else {",
      "    die(mysqli_error($conn));",
      "}",
      "",
      "// Question 3",
      "echo \"<h3>3. Category Summary</h3>\";",
      "$sql3 = \"SELECT Category, COUNT(*) AS TotalSpots,",
      "         AVG(Rating) AS AvgRating,",
      "         SUM(VisitorsPerYear) AS TotalVisitors",
      "         FROM tourist_spot",
      "         GROUP BY Category",
      "         HAVING AVG(Rating) > 4.4",
      "         ORDER BY AvgRating DESC\";",
      "showData($conn, $sql3);",
      "",
      "// Question 4",
      "echo \"<h3>4. Region Revenue</h3>\";",
      "$sql4 = \"SELECT Region,",
      "         SUM(EntryFee * VisitorsPerYear) AS Revenue",
      "         FROM tourist_spot",
      "         GROUP BY Region",
      "         HAVING SUM(EntryFee * VisitorsPerYear) > 1000000",
      "         ORDER BY Revenue DESC\";",
      "showData($conn, $sql4);",
      "",
      "mysqli_close($conn);",
      "?>",
      "</body>",
      "</html>"
