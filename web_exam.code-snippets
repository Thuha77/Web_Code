  "Health Report": {
    "prefix": "healthReport",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"en\">",
      "<head>",
      "    <meta charset=\"UTF-8\">",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "    <title>Health Report</title>",
      "</head>",
      "<body>",
      "    <h2>Health Report</h2>",
      "    <label for=\"heart\">Heart Rate</label>",
      "    <input type=\"number\" id=\"heart\" placeholder=\"Enter Heart Rate\">",
      "    <label for=\"spo2\">SpO2%</label>",
      "    <input type=\"number\" id=\"spo2\" placeholder=\"Enter SpO2\">",
      "    <button onclick=\"addData()\">Save Reading</button>",
      "    <h3>Report</h3>",
      "    <p id=\"report\"></p>",
      "    <h3>Feedback</h3>",
      "    <p id=\"Feedback\"></p>",
      "",
      "    <script>",
      "        let heart = [];",
      "        let spo2 = [];",
      "",
      "        function addData() {",
      "            let temp1 = Number(document.getElementById(\"heart\").value);",
      "            let temp2 = Number(document.getElementById(\"spo2\").value);",
      "",
      "            if (!document.getElementById(\"heart\").value ||",
      "                !document.getElementById(\"spo2\").value ||",
      "                temp1 <= 0 || temp2 < 0 || temp2 > 100) {",
      "                alert(\"Enter valid readings\");",
      "                return;",
      "            }",
      "",
      "            heart.push(temp1);",
      "            spo2.push(temp2);",
      "            document.getElementById(\"heart\").value = \"\";",
      "            document.getElementById(\"spo2\").value = \"\";",
      "",
      "            let avgheart = 0;",
      "            let avgspo2 = 0;",
      "            let count = heart.length;",
      "",
      "            for (let value of heart) {",
      "                avgheart += value;",
      "            }",
      "            avgheart /= count;",
      "",
      "            for (let value of spo2) {",
      "                avgspo2 += value;",
      "            }",
      "            avgspo2 /= count;",
      "",
      "            let RiskScore = (100 - temp2) * 2 + Math.abs(temp1 - 80) * 0.5;",
      "            let Feedback = \"\";",
      "",
      "            if (RiskScore <= 10) {",
      "                Feedback = \"SAFE\";",
      "            } else if (RiskScore <= 20) {",
      "                Feedback = \"WARNING\";",
      "            } else {",
      "                Feedback = \"DANGER\";",
      "            }",
      "",
      "            document.getElementById(\"report\").innerHTML =",
      "                \"Average Heart Rate : \" + avgheart.toFixed(2) + \"<br>\" +",
      "                \"Average Oxygen Saturation : \" + avgspo2.toFixed(2) + \"<br>\" +",
      "                \"Risk Score : \" + RiskScore;",
      "",
      "            document.getElementById(\"Feedback\").innerHTML = Feedback;",
      "        }",
      "    </script>",
      "</body>",
      "</html>"
    ],
    "description": "Health report HTML and JavaScript (averages and risk score)"
  },
  "Study Tracker": {
    "prefix": "studytracker",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"en\">",
      "<head>",
      "    <meta charset=\"UTF-8\">",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "    <title>Study Tracker</title>",
      "</head>",
      "<body>",
      "    <h2>Weekly Study Tracker</h2>",
      "    <label>Subject</label>",
      "    <input type=\"text\" id=\"subject\" placeholder=\"Subject Name\">",
      "    <br><br>",
      "    <label>Study Hour</label>",
      "    <input type=\"number\" id=\"hour\" placeholder=\"Enter Study hour\">",
      "    <br>",
      "    <button onclick=\"addStudy()\">Add Study</button>",
      "    <p id=\"result\"></p>",
      "",
      "    <script>",
      "        let total = 0;",
      "        let count = 0;",
      "        let subjects = [];",
      "",
      "        function addStudy() {",
      "            let subject = document.getElementById(\"subject\").value;",
      "            let hour = Number(document.getElementById(\"hour\").value);",
      "",
      "            if (subject.trim() === \"\" || hour <= 0) {",
      "                alert(\"Enter valid Subject and hour\");",
      "                return;",
      "            }",
      "",
      "            total += hour;",
      "            count++;",
      "            subjects.push(subject);",
      "            let feedback = \"\";",
      "",
      "            if (count > 7 && total < 20) {",
      "                feedback = \"Increase Your study Time!\";",
      "            } else if (total < 6) {",
      "                feedback = \"Start Studying Regularly!\";",
      "            } else if (total < 13) {",
      "                feedback = \"Good Progress!\";",
      "            } else if (total < 20) {",
      "                feedback = \"Almost Ready!\";",
      "            } else {",
      "                feedback = \"Weekly Goal reached\";",
      "            }",
      "",
      "            document.getElementById(\"result\").innerHTML =",
      "                \"Total \" + total + \" hours<br>\" +",
      "                \"Average \" + total / count + \" hours<br>\" +",
      "                \"Subjects \" + subjects.join(\", \") + \"<br>\" +",
      "                feedback;",
      "        }",
      "    </script>",
      "</body>",
      "</html>"
    ],
    "description": "Weekly study tracker HTML and JavaScript"
  },
  "UMRT Script": {
    "prefix": "umrtscript",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"en\">",
      "<head>",
      "    <meta charset=\"UTF-8\">",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "    <title>Rover Battery Calculator</title>",
      "</head>",
      "<body>",
      "    <form method=\"POST\">",
      "        <label>Mission Distance in Meter</label>",
      "        <input type=\"number\" name=\"distance\" step=\"any\" min=\"0\" required>",
      "        <br>",
      "        <label>Energy Consumption per Meter</label>",
      "        <input type=\"number\" name=\"consumption\" step=\"any\" min=\"0\" required>",
      "        <br>",
      "        <label>Capacity Of One Battery</label>",
      "        <input type=\"number\" name=\"capacity\" step=\"any\" min=\"0.000001\" required>",
      "        <br>",
      "        <button type=\"submit\">Calculate</button>",
      "    </form>",
      "",
      "<?php",
      "if ($_SERVER['REQUEST_METHOD'] == \"POST\") {",
      "    $distance = (float) $_POST[\"distance\"];",
      "    $consumption = (float) $_POST[\"consumption\"];",
      "    $capacity = (float) $_POST[\"capacity\"];",
      "",
      "    if ($distance < 0 || $consumption < 0 || $capacity <= 0) {",
      "        echo \"Enter valid positive battery capacity and nonnegative inputs.\";",
      "    } else {",
      "        $RequiredEnergy = $distance * $consumption;",
      "        $MinimumBatteryNeed = ceil($RequiredEnergy / $capacity);",
      "        $TotalBatteryEnergy = $MinimumBatteryNeed * $capacity;",
      "        $UnusedEnergy = $TotalBatteryEnergy - $RequiredEnergy;",
      "",
      "        if ($TotalBatteryEnergy == 0 || $UnusedEnergy <= $TotalBatteryEnergy * 0.10) {",
      "            $Feedback = 'Efficient';",
      "        } else if ($UnusedEnergy <= $TotalBatteryEnergy * 0.25) {",
      "            $Feedback = 'Acceptable';",
      "        } else {",
      "            $Feedback = 'Wasteful';",
      "        }",
      "",
      "        echo '<h4>Total Energy Required: ' . $RequiredEnergy . '</h4>';",
      "        echo '<h4>Battery Modules: ' . $MinimumBatteryNeed . '</h4>';",
      "        echo '<h4>Unused Energy: ' . $UnusedEnergy . '</h4>';",
      "        echo '<h4>Status: ' . $Feedback . '</h4>';",
      "    }",
      "}",
      "?>",
      "</body>",
      "</html>"
    ],
    "description": "PHP rover battery calculator"
  },
